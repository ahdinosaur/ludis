name: "with-secrets"
version: "0.1.0"

params: {}

# `@core/secret` defaults `path` to `/run/lusid/secrets/<name>` (tmpfs on
# systemd distros). The parent dir must exist — declare it once.
#
# To put a secret on persistent disk instead (config file in /etc, etc.),
# pass an explicit absolute `path` to `@core/secret`.

setup: (params, system) =>
  - module: "@core/directory"
    id: "secrets-dir"
    params:
      state: "present"
      path: "/run/lusid/secrets"
      mode: 0o700

  - module: "@core/secret"
    requires: ["secrets-dir"]
    params:
      name: "hello"
      # path defaults to /run/lusid/secrets/hello
